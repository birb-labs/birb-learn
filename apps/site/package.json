{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @birb-learn/content-schema run db:reset && tsx scripts/export-questions.ts && next dev",
    "build": "pnpm --filter @birb-learn/content-schema run db:reset && tsx scripts/export-questions.ts && next build",
    "typecheck": "tsc --noEmit",
    "build:from-admin": "pnpm --filter @birb-learn/content-schema run db:migrate && tsx scripts/hydrate-from-admin.ts && tsx scripts/export-questions.ts && next build",
    "test": "vitest run",
    "export-questions": "tsx scripts/export-questions.ts"
  },
  "dependencies": {
    "@birb-learn/content-schema": "workspace:*",
    "@birb-learn/math-input": "workspace:*",
    "@birb-learn/theme": "workspace:*",
    "@cortex-js/compute-engine": "0.121.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "katex": "0.18.4",
    "next": "^16.3.2",
    "next-intl": "^4.13.7",
    "next-mdx-remote-client": "2.1.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.0.1",
    "tsx": "4.19.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
