{
  "name": "@birb-learn/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest run --config vitest.config.ts --exclude 'src/client/**' && vitest run --config vitest.client.config.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "vite build && wrangler deploy --config dist/client/birb_learn_admin/wrangler.json",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@birb-learn/content-schema": "workspace:*",
    "@birb-learn/math-input": "workspace:*",
    "@birb-learn/theme": "workspace:*",
    "@mdx-js/mdx": "3.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "^4.6.0",
    "katex": "0.18.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "tsx": "4.19.2",
    "typescript": "^6.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "4.127.0"
  }
}
